# SECURE MULTI-STAGE BUILD - No malware injection possible
FROM node:20-alpine AS base

# Security: Install only essential packages
RUN apk add --no-cache dumb-init && \
    rm -rf /var/cache/apk/* /tmp/*

WORKDIR /app

# === Dependencies Stage ===
FROM base AS deps

COPY package.json package-lock.json* ./

# Clean install, ignore postinstall scripts
RUN npm ci --only=production --ignore-scripts && \
    npm cache clean --force && \
    rm -rf /tmp/* /root/.npm

# === Builder Stage ===
FROM base AS builder

COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN npm run build && \
    rm -rf /tmp/* /root/.npm

# === Production Runner ===
FROM base AS runner

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs && \
    mkdir -p /app/.next && \
    chown -R nextjs:nodejs /app

# SECURITY: Remove dangerous binaries (optional - comment out if needed)
# RUN rm -f /bin/sh /bin/ash /bin/bash /usr/bin/wget /usr/bin/curl /usr/bin/nc /usr/bin/telnet || true

# SECURITY: Make /tmp limited
RUN mkdir -p /tmp && chmod 1777 /tmp

# Copy application
COPY --from=deps --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Use dumb-init to handle zombie processes
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]
